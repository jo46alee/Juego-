generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { USER MODERATOR AGENT ADMIN SUPER_ADMIN }
enum Asset { TSX USDT }
enum ListingStatus { OPEN FILLED CANCELLED }
enum LedgerType { BONUS MISSION MARKET_BUY MARKET_SELL MARKET_FEE BUILD SPEND REWARD DEPOSIT WITHDRAW }
enum FleetStatus { IDLE TRAVELING BATTLE RETURNING }
enum MissionStatus { ACTIVE COMPLETED }
enum ResearchType { COMBAT PROPULSION ECONOMY EXPLORATION }
enum ShipType { MINER FIGHTER CRUISER TRANSPORT EXPLORER }
enum NotificationType { SYSTEM MARKET BATTLE MISSION ALLIANCE }
enum BlockchainProvider { SIMULATED EVM }

model User {
  id Int @id @default(autoincrement())
  username String @unique
  passwordHash String
  role Role @default(USER)
  createdAt DateTime @default(now())
  planets Planet[]
  wallet Wallet?
  ledger Ledger[]
  listings Listing[]
  missions UserMission[]
  fleets Fleet[]
  battleReportsAttacker BattleReport[] @relation("attacker")
  battleReportsDefender BattleReport[] @relation("defender")
  allianceMember AllianceMember?
  research Research[]
  ships Ship[]
  notifications Notification[]
  auditLogs AuditLog[]
  chainTransactions ChainTransaction[]\n  buildJobs BuildJob[]\n  expeditions Expedition[]\n  chatMessages ChatMessage[] @relation("chatAuthor")
}

model Planet {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  galaxy Int @default(1)
  system Int @default(1)
  position Int @default(1)
  metal Float @default(1000)
  crystal Float @default(500)
  deuterium Float @default(100)
  energy Float @default(100)
  metalMine Int @default(1)
  crystalMine Int @default(1)
  deutSynth Int @default(1)
  powerPlant Int @default(1)
  lastTick DateTime @default(now())\n  buildJobs BuildJob[]\n  fleetsFrom Fleet[] @relation("fleetOrigin")\n  fleetsTo Fleet[] @relation("fleetDestination")
  fleets Fleet[]
  researches Research[]
  @@unique([galaxy,system,position])
  @@index([userId])
}

model Wallet {
  id Int @id @default(autoincrement())
  userId Int @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tsx Float @default(1000)
  usdt Float @default(0)
  lockedTsx Float @default(0)
  lockedUsdt Float @default(0)
}

model Ledger {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  asset Asset
  amount Float
  type LedgerType
  reference String?
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}

model Listing {
  id Int @id @default(autoincrement())
  sellerId Int
  seller User @relation(fields:[sellerId],references:[id],onDelete:Cascade)
  asset Asset @default(TSX)
  quantity Float
  price Float
  status ListingStatus @default(OPEN)
  createdAt DateTime @default(now())
  filledAt DateTime?
  @@index([status,createdAt])
}

model Mission {
  id Int @id @default(autoincrement())
  code String @unique
  title String
  description String
  rewardTsx Float @default(0)
  rewardMetal Float @default(0)
  users UserMission[]
}

model UserMission {
  userId Int
  missionId Int
  completedAt DateTime?
  status MissionStatus @default(ACTIVE)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  mission Mission @relation(fields:[missionId],references:[id],onDelete:Cascade)
  @@id([userId,missionId])
}

model Research {
  id Int @id @default(autoincrement())
  userId Int
  planetId Int
  type ResearchType
  level Int @default(1)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  planet Planet @relation(fields:[planetId],references:[id],onDelete:Cascade)
  @@unique([userId,type])
}

model Ship {
  id Int @id @default(autoincrement())
  userId Int
  type ShipType
  quantity Int @default(0)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,type])
}

model BuildJob {\n  id Int @id @default(autoincrement())\n  userId Int\n  planetId Int\n  type JobType\n  target String\n  targetLevel Int\n  finishAt DateTime\n  status String @default("QUEUED")\n  user User @relation(fields:[userId],references:[id],onDelete:Cascade)\n  planet Planet @relation(fields:[planetId],references:[id],onDelete:Cascade)\n  createdAt DateTime @default(now())\n  @@index([userId,status,finishAt])\n}\n\nmodel Fleet {
  id Int @id @default(autoincrement())
  userId Int
  planetId Int
  name String
  ships Json
  attack Int @default(10)
  defense Int @default(10)
  speed Int @default(100)
  status FleetStatus @default(IDLE)
  destinationPlanetId Int?\n  mission FleetMission @default(TRANSPORT)\n  cargo Json?\n  origin Planet @relation("fleetOrigin",fields:[planetId],references:[id],onDelete:Cascade)\n  destination Planet? @relation("fleetDestination",fields:[destinationPlanetId],references:[id],onDelete:SetNull)
  departureAt DateTime?
  arrivalAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  planet Planet @relation(fields:[planetId],references:[id],onDelete:Cascade)
  @@index([userId,status])
}

model BattleReport {
  id Int @id @default(autoincrement())
  attackerId Int
  defenderId Int
  winnerId Int
  attackerPower Int
  defenderPower Int
  attackerLosses Json
  defenderLosses Json
  createdAt DateTime @default(now())
  attacker User @relation("attacker",fields:[attackerId],references:[id],onDelete:Cascade)
  defender User @relation("defender",fields:[defenderId],references:[id],onDelete:Cascade)
}

model Alliance {
  id Int @id @default(autoincrement())
  name String @unique
  tag String @unique
  createdAt DateTime @default(now())
  members AllianceMember[]
}

model AllianceMember {
  userId Int @unique
  allianceId Int
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  alliance Alliance @relation(fields:[allianceId],references:[id],onDelete:Cascade)
  joinedAt DateTime @default(now())
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int
  type NotificationType
  title String
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,read,createdAt])
}

model AuditLog {
  id Int @id @default(autoincrement())
  userId Int?
  action String
  entity String
  entityId String?
  ip String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  @@index([createdAt])
}

model IdempotencyKey {
  id Int @id @default(autoincrement())
  userId Int
  key String
  response Json
  createdAt DateTime @default(now())
  @@unique([userId,key])
}

model ChainTransaction {
  id Int @id @default(autoincrement())
  userId Int
  provider BlockchainProvider
  asset Asset
  direction String
  txHash String @unique
  amount Float
  status String @default("CONFIRMED")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}
\nmodel Expedition {\n  id Int @id @default(autoincrement())\n  userId Int\n  fleetId Int?\n  status String @default("RUNNING")\n  rewardTsx Float @default(0)\n  rewardMetal Float @default(0)\n  rewardCrystal Float @default(0)\n  startedAt DateTime @default(now())\n  finishAt DateTime\n  user User @relation(fields:[userId],references:[id],onDelete:Cascade)\n  fleet Fleet? @relation(fields:[fleetId],references:[id],onDelete:SetNull)\n  @@index([userId,status,finishAt])\n}\n\nmodel Season {\n  id Int @id @default(autoincrement())\n  name String\n  status SeasonStatus @default(UPCOMING)\n  startsAt DateTime\n  endsAt DateTime\n  createdAt DateTime @default(now())\n}\n\nmodel ChatMessage {\n  id Int @id @default(autoincrement())\n  userId Int\n  channel String @default("global")\n  message String\n  createdAt DateTime @default(now())\n  user User @relation("chatAuthor",fields:[userId],references:[id],onDelete:Cascade)\n  @@index([channel,createdAt])\n}\n